// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  clerkId       String    @unique
  email         String    @unique
  username      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  properties    Property[] @relation("CreatedBy")
  savedProperties Property[] @relation("SavedBy", fields: [savedPropertyIds], references: [id])
  savedPropertyIds String[] @db.ObjectId
  bookingRequests BookingRequest[] @relation("RequestedBy")
  receivedMessages Message[] @relation("ReceivedBy")
  sentMessages    Message[] @relation("SentBy")
}

enum Role {
  USER
  AGENT
  ADMIN
}

model Property {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String
  price         Float
  address       String
  city          String
  state         String
  country       String
  zipCode       String
  images        String[]
  features      String[]
  type          PropertyType
  status        PropertyStatus
  bedrooms      Int
  bathrooms     Float
  area          Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     User      @relation("CreatedBy", fields: [createdById], references: [id])
  createdById   String    @db.ObjectId
  savedBy       User[]    @relation("SavedBy", fields: [savedByIds], references: [id])
  savedByIds    String[]  @db.ObjectId
  bookingRequests BookingRequest[]
  views         Int       @default(0)
}

enum PropertyType {
  APARTMENT
  HOUSE
  CONDO
  TOWNHOUSE
  LAND
  COMMERCIAL
}

enum PropertyStatus {
  FOR_SALE
  FOR_RENT
  SOLD
  RENTED
}

model BookingRequest {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  message       String
  status        BookingStatus @default(PENDING)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  property      Property  @relation(fields: [propertyId], references: [id])
  propertyId    String    @db.ObjectId
  user          User      @relation("RequestedBy", fields: [userId], references: [id])
  userId        String    @db.ObjectId
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Message {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  content       String
  createdAt     DateTime  @default(now())
  from          User      @relation("SentBy", fields: [fromId], references: [id])
  fromId        String    @db.ObjectId
  to            User      @relation("ReceivedBy", fields: [toId], references: [id])
  toId          String    @db.ObjectId
  read          Boolean   @default(false)
}
